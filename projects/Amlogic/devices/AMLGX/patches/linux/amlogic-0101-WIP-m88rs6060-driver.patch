+	{ "m88rs6060", (kernel_ulong_t)&m88rs6060_configs[0] },
+	{ "m88rs6060-27p", (kernel_ulong_t)&m88rs6060_configs[0] },
+	{ "m88rs6060-27s", (kernel_ulong_t)&m88rs6060_configs[1] },
