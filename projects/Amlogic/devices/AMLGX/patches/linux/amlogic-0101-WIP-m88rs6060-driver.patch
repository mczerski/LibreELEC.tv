+  iVar3 = (int)((xm_list_dBm[local_31[0]] / 10 - 0x1a9) - iVar3) / 10;
+  iVar4 = -0x6b;
+  if (-0x6c < iVar3) {
+    iVar4 = iVar3;
+  }
+  *strength = iVar4;
+	if (fe->ops.i2c_gate_ctrl)
+		fe->ops.i2c_gate_ctrl(fe, 0);
+  return 0;
+}
+
+static struct dvb_tuner_ops m88tc6800_tuner_ops = {
+	.info = {
+		.name = "Montage M88TC6800",
+		.frequency_min_hz = 48 * MHz,
+		.frequency_max_hz = 900 * MHz,
+		.frequency_step_hz = 1 * kHz,
+	},
+	.init              = m88tc6800_init,
+	.set_params        = m88tc6800_set_params,
+	.get_frequency     = m88tc6800_get_frequency,
+	.get_bandwidth     = m88tc6800_get_bandwidth,
+	.get_rf_strength   = m88tc6800_get_rf_strength,
+};
+
+static int m88tc6800_bind(struct device *dev,
+                        struct device *master,
+                        void *data)
+{
+    struct i2c_client *client = to_i2c_client(dev);
+    struct m88tc6800_priv *priv = i2c_get_clientdata(client);
+    struct dvb_frontend *fe = data;
+    int ret = 0;
+
+	fe->tuner_priv = priv;
+	ret = m88tc6800_init(fe);
+	if (ret) {
+        dev_err(&client->dev, "Failed to attach M88TC6800\n");
+		goto err;
+    }
+
+	memcpy(&fe->ops.tuner_ops, &m88tc6800_tuner_ops,
+	       sizeof(struct dvb_tuner_ops));
+
+	dev_info(&client->dev, "Attaching M88TC6800\n");
+
+    return 0;
+
+err:
+    return -1;
+}
+
+static void m88tc6800_unbind(struct device *dev,
+                           struct device *master,
+                           void *data)
+{
+    struct i2c_client *client = to_i2c_client(dev);
+    struct dvb_frontend *fe = data;
+	fe->tuner_priv = NULL;
+    memset(&fe->ops.tuner_ops, 0, sizeof(struct dvb_tuner_ops));
+    dev_info(&client->dev, "unbinding\n");
+}
+
+static const struct component_ops m88tc6800_component_ops = {
+    .bind = m88tc6800_bind,
+    .unbind = m88tc6800_unbind,
+};
+
+
+static int m88tc6800_probe(struct i2c_client *client)
+{
+    struct i2c_adapter *i2c = client->adapter;
+    const struct m88tc6800_config *config = i2c_get_match_data(client);
+	struct m88tc6800_priv *priv = NULL;
+	int ret;
+
+	priv = kzalloc(sizeof(struct m88tc6800_priv), GFP_KERNEL);
+	if (!priv) {
+		dev_err(&i2c->dev, "kzalloc() failed\n");
+		return -1;
+	}
+
+	memcpy(&priv->config, config, sizeof(priv->config));
+	priv->i2c = i2c;
+	priv->config.addr = client->addr;
+	priv->mcu_status = false;
+
+	dev_info(&i2c->dev, "Attaching M88TC6800\n");
+
+    i2c_set_clientdata(client, priv);
+    ret = component_add(&client->dev, &m88tc6800_component_ops);
+    if (ret) {
+        dev_err(&client->dev, "Failed to add as component\n");
+        goto err;
+    }
+
+	return 0;
+
+err:
+    kfree(priv);
+    return -1;
+}
+
+static void m88tc6800_remove(struct i2c_client *client)
+{
+	struct m88tc6800_priv *priv = i2c_get_clientdata(client);
+
+    component_del(&client->dev, &m88tc6800_component_ops);
+
+    dev_info(&priv->i2c->dev, "M88TC6800 removing\n");
+
+    kfree(priv);
+
+    return;
+}
+
