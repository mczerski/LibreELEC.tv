+	    .custom_cfg = 0,
+	    .harmonic_imp = 1,
+	    .dac_gain = 2,
+	    .dac = 4570,
+    },
+};
+
+static const struct of_device_id m88tc6800_of_match[] = {
+    { .compatible = "montage,m88tc6800-27", .data = &m88tc6800_configs[0] },
+    {}
+};
+MODULE_DEVICE_TABLE(of, m88tc6800_of_match);
+
+static const struct i2c_device_id m88tc6800_id_table[] = {
+    { "m88tc6800-27", (kernel_ulong_t)&m88tc6800_configs[0] },
+	{}
+};
+MODULE_DEVICE_TABLE(i2c, m88tc6800_id_table);
+
+static struct i2c_driver m88tc6800_driver = {
+    .driver = {
+        .name                = "m88tc6800",
+        .of_match_table      = m88tc6800_of_match,
+    },
+    .probe      = m88tc6800_probe,
+    .remove     = m88tc6800_remove,
+    .id_table   = m88tc6800_id_table,
+};
+
+module_i2c_driver(m88tc6800_driver);
+
+MODULE_DESCRIPTION("Montage M88TC6800 tuner driver");
+MODULE_AUTHOR("Marek Czerski <ma.czerski@gmail.com>");
+MODULE_LICENSE("GPL");
