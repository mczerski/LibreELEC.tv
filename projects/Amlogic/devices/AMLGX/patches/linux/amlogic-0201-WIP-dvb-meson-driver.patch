+static int m88tc6800_bind(struct device *dev,
+                        struct device *master,
+                        void *data)
+{
+    struct i2c_client *client = to_i2c_client(dev);
+    struct m88tc6800_priv *priv = i2c_get_clientdata(client);
+    struct dvb_frontend *fe = *(struct dvb_frontend **)data;
+    int ret = 0;
+
+	fe->tuner_priv = priv;
+	ret = m88tc6800_init(fe);
+	if (ret) {
+        dev_err(&client->dev, "Failed to attach M88TC6800\n");
+		goto err;
+    }
+
+	memcpy(&fe->ops.tuner_ops, &m88tc6800_tuner_ops,
+	       sizeof(struct dvb_tuner_ops));
+
+	dev_info(&client->dev, "Attaching M88TC6800\n");
+
+    return 0;
+
+err:
