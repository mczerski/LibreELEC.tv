+static int m88tc6800_probe(struct i2c_client *client)
+{
+    struct i2c_adapter *i2c = client->adapter;
+    const struct m88tc6800_config *config = i2c_get_match_data(client);
+	struct m88tc6800_priv *priv = NULL;
+	int ret;
+
+	priv = kzalloc(sizeof(struct m88tc6800_priv), GFP_KERNEL);
+	if (!priv) {
+		dev_err(&i2c->dev, "kzalloc() failed\n");
+		return -1;
+	}
+
+	memcpy(&priv->config, config, sizeof(priv->config));
+	priv->i2c = i2c;
+	priv->config.addr = client->addr;
+	priv->mcu_status = false;
+
+	dev_info(&i2c->dev, "Attaching M88TC6800\n");
+
+    i2c_set_clientdata(client, priv);
+    ret = component_add(&client->dev, &m88tc6800_component_ops);
+    if (ret) {
+        dev_err(&client->dev, "Failed to add as component\n");
+        goto err;
+    }
+
+	return 0;
+
+err:
+    kfree(priv);
+    return -1;
+}
+
+static void m88tc6800_remove(struct i2c_client *client)
+{
+	struct m88tc6800_priv *priv = i2c_get_clientdata(client);
+
+    component_del(&client->dev, &m88tc6800_component_ops);
+
+    dev_info(&priv->i2c->dev, "M88TC6800 removing\n");
+
+    kfree(priv);
+
+    return;
+}
