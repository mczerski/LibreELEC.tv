+static int aml_dvb_dsc_init(struct aml_dvb *advb, struct aml_dsc *dsc, int id)
+{
+	int i;
+
+	for (i = 0; i < DSC_COUNT; i++) {
+		dsc->channel[i].id = i;
+		dsc->channel[i].used = 0;
+		dsc->channel[i].set = 0;
+		dsc->channel[i].pid = 0x1fff;
+		dsc->channel[i].dsc = dsc;
