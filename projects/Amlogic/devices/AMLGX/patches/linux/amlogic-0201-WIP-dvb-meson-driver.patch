+					    dvb->sub_buf_len, DMA_FROM_DEVICE);
+
+	pr_dbg("sub buff shared: %lx %x\n",
+	       (unsigned long)virt_to_phys((void *)dvb->sub_pages),
+	       dvb->sub_buf_len);
+#endif
+	return 0;
+}
