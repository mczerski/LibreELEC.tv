+        else if (freq_khz < 167000) {
+            reg_data = 0x0d;
+            priv->ldiv = 0x30;
+        }
+        else if (freq_khz < 250000) {
+            reg_data = 0x09;
+            priv->ldiv = 0x20;
+        }
+        else if (freq_khz < 335000) {
+            reg_data = 0x0c;
+            priv->ldiv = 0x18;
+        }
+        else {
+            reg_data = 0x08;
+            priv->ldiv = 0x10;
+        }
+    }
