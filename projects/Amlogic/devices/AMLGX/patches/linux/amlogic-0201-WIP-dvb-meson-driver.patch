+static int m88rs6060_bind(struct device *dev, struct device *master, void *data)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct m88rs6060_dev *priv = i2c_get_clientdata(client);
+	struct dvb_frontend **fe = data;
+
+	*fe = &priv->fe;
+
+	return 0;
+}
