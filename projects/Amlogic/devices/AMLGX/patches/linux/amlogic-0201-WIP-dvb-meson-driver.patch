+static int _gpio_out(struct gpio_desc *gpio, int val, const char *owner)
+{
+	int ret = 0;
+
+	if (val < 0) {
+		pr_dbg("gpio out val = -1.\n");
+		return -1;
+	}
+	if (val != 0)
+		val = 1;
+	ret = gpiod_direction_output(gpio, val);
+	pr_dbg("smc gpio out ret %d\n", ret);
+	return ret;
+}
