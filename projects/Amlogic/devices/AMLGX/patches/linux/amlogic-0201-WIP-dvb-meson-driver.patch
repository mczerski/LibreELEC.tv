+#if defined(MEM_DEBUG) || defined(FILE_DEBUG)
+void debug_write(const char __user *buf, size_t count)
+{
+	mm_segment_t old_fs;
+
+	if (!debug_filp)
+		return;
+
+	old_fs = get_fs();
+	set_fs(KERNEL_DS);
+
+	if (count != vfs_write(debug_filp, buf, count, &debug_file_pos))
+		pr_dbg("Failed to write debug file\n");
+
