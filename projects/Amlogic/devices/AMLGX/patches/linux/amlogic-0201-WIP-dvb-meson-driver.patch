+#ifdef CONFIG_COMPAT
+static long smc_ioctl_compat(struct file *filp, unsigned int cmd,
+			     unsigned long args)
+{
+	unsigned long ret;
+
+	args = (unsigned long)compat_ptr(args);
+	ret = smc_ioctl(filp, cmd, args);
+	return ret;
+}
