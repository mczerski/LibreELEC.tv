+	_gpio_out(smc->enable_5v3v_pin,
+		  smc->enable_5v3v_level, SMC_ENABLE_5V3V_PIN_NAME);
+	pr_error("enable_5v3v_pin: -->(%d)\n", (smc->enable_5v3v_level) ? 1 : 0);
+	mutex_unlock(&smc_lock);
+
+	return count;
