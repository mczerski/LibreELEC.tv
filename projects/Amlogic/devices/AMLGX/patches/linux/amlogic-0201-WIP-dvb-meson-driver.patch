+
+	for (i = ulPLSIndex; i <= ulPLSCode; i++) {
+		iPLSCode[0] = (x7 << 7) + (x6 << 6) + (x5 << 5) + (x4 << 4) +
+			      (x3 << 3) + (x2 << 2) + (x1 << 1) + (x0 << 0);
+		iPLSCode[1] = (x15 << 7) + (x14 << 6) + (x13 << 5) +
+			      (x12 << 4) + (x11 << 3) + (x10 << 2) + (x9 << 1) +
+			      (x8 << 0);
+		iPLSCode[2] = (x17 << 1) + x16;
+
+		tmp = (x0 ^ x7) & 0x01;
+		x0 = x1;
+		x1 = x2;
+		x2 = x3;
+		x3 = x4;
+		x4 = x5;
+		x5 = x6;
+		x6 = x7;
+		x7 = x8;
+		x8 = x9;
+		x9 = x10;
+		x10 = x11;
+		x11 = x12;
+		x12 = x13;
+		x13 = x14;
+		x14 = x15;
+		x15 = x16;
+		x16 = x17;
+		x17 = tmp;
+	}
+
+	pNormalCode[0] = iPLSCode[0];
+	pNormalCode[1] = iPLSCode[1];
+	pNormalCode[2] = iPLSCode[2];
+
+	return;
+}
